{
  "name": "nalukesa",
  "version": "0.3.0",
  "description": "NALUKESA — Affiliate Discovery & Intelligence Hub",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "vite build && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply nalukesa-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply nalukesa-production --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name nalukesa --branch main",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sparkmind-obp-off/Nalukesa.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Sparkmind-obp-off/Nalukesa/issues"
  },
  "homepage": "https://github.com/Sparkmind-obp-off/Nalukesa#readme",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.17"
  },
  "private": true,
  "type": "module"
}
