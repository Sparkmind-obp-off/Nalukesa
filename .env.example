# Copy to .dev.vars for local `wrangler pages dev`. NEVER commit real values.
# Production: set with `npx wrangler pages secret put <NAME> --project-name nalukesa`
OWNER_PASSWORD=
# >= 32 random chars, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# "development" allows non-HTTPS cookie locally. Leave unset in production.
APP_ENV=development
